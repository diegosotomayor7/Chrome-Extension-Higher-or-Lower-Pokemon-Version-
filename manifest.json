{
  "manifest_version": 3,
  "name": "Higher or Lower Pokemon Edition",
  "version": "1.2",
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo128.png",
    "823": "logofull.png"
  },
  "description": "Guess which Pokemon has higher stats!",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}